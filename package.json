{
  "name": "mqtt-explorer-alt",
  "version": "1.0.3",
  "description": "Modern cross-platform MQTT client — an open-source alternative inspired by MQTT Explorer",
  "main": "out/main/main.js",
  "author": "Numan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmnclk/mqtt-explorer-alt.git"
  },
  "bugs": {
    "url": "https://github.com/nmnclk/mqtt-explorer-alt/issues"
  },
  "homepage": "https://github.com/nmnclk/mqtt-explorer-alt#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps && (xattr -cr node_modules/electron/dist/Electron.app 2>/dev/null || true)",
    "build:mac": "npm run build && electron-builder --mac",
    "build:dmg": "npm run build && electron-builder --mac dir && ./scripts/sign-mac-app.sh && electron-builder --mac dmg --prepackaged \"$(find release -name 'MQTT Explorer Alt.app' -type d | head -1)\"",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:linux": "npm run build && electron-builder --linux AppImage",
    "build:all": "npm run build && electron-builder --mac dmg --win nsis --linux AppImage",
    "install:mac": "npm run build:mac && node scripts/install-mac.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.numan.mqttexplorer",
    "productName": "MQTT Explorer Alt",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "artifactName": "MQTT-Explorer-Alt-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Numan"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "nmnclk",
      "repo": "mqtt-explorer-alt"
    }
  }
}
